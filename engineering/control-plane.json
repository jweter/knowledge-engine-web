{
  "schema_version": 4,
  "portfolio_project": "Knowledge Engine",
  "repository": "jweter/knowledge-engine-web",
  "repository_role": "web",
  "source_of_truth": "GitHub repository state plus authoritative documents listed below",
  "authoritative_documents": [
    "docs/project-status.yaml",
    "docs/agent-development-policy.md",
    "docs/web_design.md",
    "docs/research_report_v1.md",
    "docs/INDUSTRY_REALITY_CHECK.md",
    "AGENTS.md",
    "CLAUDE.md"
  ],
  "definition_of_done": {
    "implementation_complete": true,
    "tests_required_for_change_scope": true,
    "current_required_ci_green": true,
    "mergeability_resolved": true,
    "blocking_reviews_and_comments_resolved": true,
    "architecture_security_licensing_provenance_privacy_clear": true,
    "documentation_updated_when_project_reality_changes": true,
    "regression_protection_for_reproduced_bugs": "when practical",
    "product_reality": "pre-merge only when explicitly documented; otherwise track as post-merge acceptance debt"
  },
  "invariants": [
    "answer_first_ui",
    "inspectable_evidence",
    "no_fabricated_backend_state",
    "web_does_not_become_core_or_ai"
  ],
  "verification": {
    "automated_lanes": [
      "quality",
      "security",
      "unit_integration",
      "contract_compatibility",
      "rendering_regression"
    ],
    "product_reality_lanes": [
      "monster_79_rendered_report_acceptance"
    ],
    "rule": "never convert missing human evidence into PASS; keep implementation status separate from Product Reality acceptance",
    "executable_lanes": [
      {
        "id": "research_report_web_golden",
        "steps": [
          [
            "poetry",
            "run",
            "pytest",
            "tests/test_general_question_research_loop.py",
            "tests/test_main.py::test_ask_withholds_a_narrative_when_the_close_gate_blocks",
            "tests/test_main.py::test_ask_shows_specific_verification_findings_when_flagged",
            "-q"
          ]
        ],
        "evidence": "Web GQR state mapping and Research Report trust/rendering regression"
      }
    ]
  },
  "work_ownership": {
    "authority": "GitHub",
    "active_work_sources": [
      "open pull requests",
      "open issues with active implementation evidence",
      "recent focused branches/commits when attributable"
    ],
    "rule": "do not duplicate or compete with active work; prefer finishing existing work"
  },
  "regression_memory": {
    "path": "engineering/regression-memory.json",
    "rule": "record significant or recurring reproduced failures with root cause, fix, verification, regression protection, and residual risk"
  },
  "readiness_scoring": {
    "mode": "evidence-derived",
    "prohibit_guessed_percent_complete": true,
    "dimensions": [
      "implementation",
      "automated_verification",
      "integration",
      "product_reality",
      "documentation",
      "security_and_policy"
    ],
    "rule": "report unknown when evidence is insufficient"
  },
  "continuation": "derive from current Web roadmap/status and Knowledge Engine dependency-safe continuation",
  "cross_repo_authorities": [
    {
      "repository": "jweter/knowledge-engine-core",
      "path": "docs/roadmap/research_report_v1.md",
      "purpose": "family Research Report v1 authority"
    }
  ],
  "portfolio_aggregation": {
    "project_key": "knowledge-engine",
    "component_role": "web",
    "required_components": [
      "core",
      "web",
      "ai"
    ],
    "authority": "hourly portfolio orchestrator",
    "rule": "aggregate only verified repository evidence; never infer missing component state"
  },
  "golden_scenarios": [
    {
      "id": "research-report-v1",
      "component": "web",
      "lane": "research_report_web_golden",
      "rule": "portfolio scenario is VERIFIED only when core, web, and ai component lanes are green on their current exact heads"
    }
  ],
  "preflight": {
    "required_before_pr": true,
    "evidence_file": "preflight-evidence.json",
    "format_apply": [
      "poetry",
      "run",
      "ruff",
      "format",
      "."
    ],
    "checks": [
      {
        "id": "format",
        "argv": [
          "poetry",
          "run",
          "ruff",
          "format",
          "--check",
          "."
        ],
        "kind": "quality",
        "fast": true
      },
      {
        "id": "lint",
        "argv": [
          "poetry",
          "run",
          "ruff",
          "check",
          "."
        ],
        "kind": "quality",
        "fast": true
      },
      {
        "id": "control_plane",
        "argv": [
          "poetry",
          "run",
          "python",
          "engineering/validate_control_plane.py"
        ],
        "kind": "governance",
        "fast": true
      },
      {
        "id": "regression_memory",
        "argv": [
          "poetry",
          "run",
          "python",
          "engineering/validate_regression_memory.py"
        ],
        "kind": "governance",
        "fast": true
      },
      {
        "id": "types",
        "argv": [
          "poetry",
          "run",
          "mypy",
          "knowledge_engine_web",
          "tests"
        ],
        "kind": "quality",
        "fast": false
      },
      {
        "id": "tests",
        "argv": [
          "poetry",
          "run",
          "pytest",
          "-q"
        ],
        "kind": "test",
        "fast": false
      },
      {
        "id": "golden",
        "argv": [
          "poetry",
          "run",
          "python",
          "engineering/run_verification.py",
          "--lane",
          "research_report_web_golden"
        ],
        "kind": "golden",
        "fast": false
      }
    ],
    "policy": "ordinary PRs require GREEN full preflight evidence on the exact head; use PREFLIGHT_UNVERIFIED only for a legitimate environment limitation and record the reason"
  },
  "promotion": {
    "states": [
      "IMPLEMENTING",
      "PREFLIGHT_UNVERIFIED",
      "PREFLIGHT_GREEN",
      "PR_OPEN",
      "CI_PENDING",
      "GREEN",
      "MERGED",
      "PRODUCT_REALITY_PENDING",
      "PRODUCT_REALITY_VERIFIED"
    ],
    "rule": "advance only from verified evidence; never skip FAILED/PENDING/UNCERTAIN gates"
  }
}
